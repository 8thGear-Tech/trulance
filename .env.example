# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key (https://resend.com → API Keys)
RESEND_API_KEY=

# Where form submissions are delivered
CONTACT_TO_EMAIL=info@trulance.io

# Sender address — must be on a domain verified in Resend (e.g. trulance.io)
CONTACT_FROM_EMAIL="Trulance Website <website@trulance.io>"
